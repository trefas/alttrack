# Host port for the web UI (container always listens on 8300)
ALTTRACK_PORT=8300

# Minutes between repository refreshes
ALTTRACK_REFRESH_INTERVAL=30

# Journal rows older than this are archived (days)
ALTTRACK_ARCHIVE_AFTER_DAYS=90

# Timeout for ALTRepo API requests (seconds)
ALTTRACK_HTTP_TIMEOUT=30.0

# ALTRepo API endpoint
ALTTRACK_API_BASE_URL=https://rdb.altlinux.org/api
